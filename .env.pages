# podium 自己的展示站环境（GitHub Pages）。
#
# 只服务框架本体的演示站，业务项目派生出去后可以整份删除。
# 展示站没有后端：登录和示例数据都由内置的 MSW mock 提供。
# 产物是公开的静态文件，这里只能放会被原样打进 bundle 的公开配置。

NUXT_PUBLIC_APP_NAME=Podium

# 部署子路径由 scripts/build-pages.mjs 按仓库名自动推导，
# 需要固定时用命令行或 GitHub Variables 覆盖，这里不写。

# 没有真实后端，接口地址留空；请求由 mock 在浏览器里接管
NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_API_MOCK=1

# 演示站保留 demo 路由 / 菜单 / 文案
PODIUM_DEMO=1

# 演示站不连接 STOMP
NUXT_PUBLIC_STOMP_URL=
NUXT_PUBLIC_STOMP_RECONNECT_DELAY=5000
NUXT_PUBLIC_STOMP_AUTH_HEADER=Authorization
NUXT_PUBLIC_STOMP_DEBUG=0
