# 全部可用环境变量的说明。实际取值按环境放在 .env.<环境>，不要提交 .env。
# 纯前端静态应用：NUXT_PUBLIC_* 会原样打进构建产物，禁止放密钥 / 令牌。
# 详细说明见 docs/env.md。

# 应用名，构建期写入 index.html 的标题
NUXT_PUBLIC_APP_NAME=Podium

# 部署子路径（GitHub Pages 项目页这类场景）。必须是 / 开头、/ 结尾。
# 放在根路径时保持 /；pnpm build:github-pages 会自动推导仓库页路径。
NUXT_APP_BASE_URL=/

# 接口基础地址，前端通过 useRuntimeConfig().public.apiBaseUrl 读取
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# 构建期开关：0 表示移除 demo 路由与文案（pnpm build:prod 会自动设置）
# PODIUM_DEMO=1

# STOMP：原生 WebSocket 地址，必须是 ws:// 或 wss://
# 留空表示不建立连接；地址在构建期写入产物，部署后不能只改环境变量生效
NUXT_PUBLIC_STOMP_URL=
# 断线重连间隔（毫秒），0 表示关闭自动重连
NUXT_PUBLIC_STOMP_RECONNECT_DELAY=5000
# STOMP CONNECT 帧里放 token 的 header 名
NUXT_PUBLIC_STOMP_AUTH_HEADER=Authorization
# 是否输出 stompjs 调试日志；会包含 Authorization，生产必须为 0
NUXT_PUBLIC_STOMP_DEBUG=0
