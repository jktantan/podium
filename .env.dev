# 开发环境（pnpm dev 的默认值）
# 仅放公开配置：NUXT_PUBLIC_* 会原样打进静态产物，不要写密钥。
# 本文件入库；个人覆盖请用 .env.dev.local（已 gitignore）。
NUXT_PUBLIC_APP_NAME=Podium Dev
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# STOMP（原生 WebSocket），地址为空表示不连接
NUXT_PUBLIC_STOMP_URL=
NUXT_PUBLIC_STOMP_RECONNECT_DELAY=5000
NUXT_PUBLIC_STOMP_AUTH_HEADER=Authorization
NUXT_PUBLIC_STOMP_DEBUG=0

# 内置 mock：登录与示例数据由 app/mocks 提供，接入真实后端后删掉这一行
NUXT_PUBLIC_API_MOCK=1
